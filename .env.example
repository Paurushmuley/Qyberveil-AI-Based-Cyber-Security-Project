# ==============================================================================
# Qyberveil Environment Configuration
# ==============================================================================

# Core Application
NODE_ENV=development
PORT=8000
CORS_ORIGIN=http://localhost:5173,http://localhost:8000

# Database (PostgreSQL)
# Format: postgresql://<user>:<password>@<host>:<port>/<database>?schema=public
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/qyberveil?schema=public

# Queue & Cache (Redis)
REDIS_URL=redis://localhost:6379

# Cryptography & Secret Encryption
# 32-character or longer encryption secret used to encrypt AI API keys at rest
ENCRYPTION_KEY=qyberveil_ai_super_secret_master_key_32_bytes!

# JWT Authentication
JWT_SECRET=qyberveil_jwt_super_secret_signing_key_2026_dev
JWT_EXPIRES_IN=7d

# Target Scope & SSRF Guardrails
# Set to 'true' ONLY in controlled local testing to permit scans against 127.0.0.1 or local docker networks
ALLOW_PRIVATE_TARGETS=false

# AI Providers (Configured via UI or preset for local development)
# Local Ollama URL
OLLAMA_BASE_URL=http://localhost:11434

# Optional Cloud AI API Keys (can also be entered dynamically via UI)
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# GROK_API_KEY=
